# /etc/systemd/system/unboxed-web.service — the Next.js app (standalone build)
[Unit]
Description=UnboxEd web app
After=network.target unboxed-api.service

[Service]
User=unboxed
WorkingDirectory=/srv/unboxed/current/apps/web/.next/standalone
Environment=NODE_ENV=production PORT=3010 HOSTNAME=127.0.0.1 NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/unboxed/production.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
