# /etc/systemd/system/unboxed-worker.service — runs background jobs (document processing today; ingestion later)
[Unit]
Description=UnboxEd background worker
After=network.target postgresql.service

[Service]
User=unboxed
WorkingDirectory=/srv/unboxed/current
EnvironmentFile=/etc/unboxed/production.env
Environment=PYTHONPATH=/srv/unboxed/current/apps/api:/srv/unboxed/current
ExecStart=/srv/unboxed/venv/bin/python -m workers.worker
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
