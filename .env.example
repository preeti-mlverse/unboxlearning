# Copy to .env for local development. Never commit .env. Staging and production set these in the server's
# environment (see docs/foundation/DEPLOY.md). Every value below has a safe local default, so an empty .env works.

ENVIRONMENT=local                     # local | staging | production

# --- database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://unboxed:unboxed_dev@localhost:5432/unboxed
# TEST_DATABASE_URL=postgresql+psycopg://unboxed:unboxed_dev@localhost:5432/unboxed_test

# --- where things live (used for links in emails, redirects after log-in, and CORS)
APP_URL=http://localhost:3010         # the product app (Next.js)
SITE_URL=http://localhost:5195        # the marketing site (unboxlearning.in)
API_URL=http://localhost:8040         # this API; the web app forwards /api/* here
CORS_ORIGINS=                         # extra comma-separated origins, if any

# --- sessions
# SECRET_KEY=                         # staging/production: 32+ random characters (python -c "import secrets;print(secrets.token_urlsafe(48))")
COOKIE_DOMAIN=                        # staging/production: .unboxlearning.in (shares the session between site and app)
COOKIE_SECURE=false                   # staging/production: true
REQUIRE_EMAIL_VERIFICATION=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- files
STORAGE_BACKEND=local                 # local private folder today; s3 (Supabase Storage / S3) later
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- email (without SMTP_HOST, emails are written to storage/outbox/ instead of being sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UnboxEd <no-reply@unboxlearning.in>

# --- web app (Next.js) build-time values
NEXT_PUBLIC_SITE_URL=http://localhost:5195

# --- reserved for later waves (not used during Foundation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REDIS_URL=
