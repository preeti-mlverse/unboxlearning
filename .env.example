# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic | mock
# Model tiers — set to models available on your account (python -m engine.cli models lists them)
MODEL_FAST=gpt-5-mini
MODEL_STANDARD=gpt-5
MODEL_PREMIUM=gpt-5
EMBED_MODEL=text-embedding-3-small
TTS_MODEL=gpt-4o-mini-tts
REASONING_EFFORT=low
MAX_PARALLEL=6
MAX_SECTIONS=60
# ANTHROPIC_API_KEY=
